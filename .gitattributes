# Normalise to LF in the repo; check out native on Windows.
* text=auto

# Scripts that must keep their line endings whatever the checkout platform.
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.sh    text eol=lf

# UE and Rust sources are plain text.
*.rs    text
*.cpp   text
*.h     text
*.cs    text
*.uplugin  text
*.uproject text

# UE binary assets, should the repo ever carry any.
*.uasset binary
*.umap   binary
*.png    binary
*.jpg    binary

# Test fixtures are compared byte for byte — never let git rewrite their
# line endings on checkout.
tests/fixtures/** -text
