{
  "name": "blueprint_debug_status",
  "description": "what the debugger knows about a Blueprint, and whether execution is halted",
  "route": "/api/blueprints/debug",
  "tool": "blueprint_debug",
  "request": {
    "operation": "status",
    "blueprint": "/Game/Blueprints/BP_McpDebugProbe"
  },
  "status": 200,
  "response": {
    "ok": true,
    "data": {
      "blueprint": "/Game/Blueprints/BP_McpDebugProbe.BP_McpDebugProbe",
      "has_breakpoints": true,
      "has_watches": true,
      "has_debugging_data": true,
      "single_stepping": false,
      "in_pie": false,
      "halted": false,
      "debug_object": "",
      "debug_object_path_hint": ""
    }
  }
}
