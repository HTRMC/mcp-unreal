{
  "name": "ui_asset_not_found_error",
  "description": "opening an editor for a missing asset is a 404",
  "route": "/api/editor/ui_ops",
  "tool": "ui_ops",
  "request": {
    "operation": "open_asset",
    "asset": "/Game/NotAnAsset"
  },
  "status": 404,
  "response": {
    "ok": false,
    "error": {
      "code": "asset_not_found",
      "message": "no asset at '/Game/NotAnAsset'"
    }
  }
}
