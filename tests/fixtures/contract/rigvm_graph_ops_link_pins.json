{
  "name": "rigvm_graph_ops_link_pins",
  "description": "rigvm_graph_ops link_pins: an execute link between two nodes",
  "route": "/api/anim/rigvm_graph",
  "tool": "rigvm_graph_ops",
  "request": {
    "operation": "link_pins",
    "rig": "/Game/Rigs/CR_Contract",
    "from": "RigUnit_BeginExecution.ExecutePin",
    "to": "SetPelvis.ExecutePin"
  },
  "status": 200,
  "response": {
    "ok": true,
    "data": {
      "rig": "/Game/Rigs/CR_Contract.CR_Contract",
      "graph": "RigVMModel::",
      "nodes": [
        {
          "node": "RigUnit_BeginExecution",
          "title": "Forwards Solve",
          "class": "RigVMUnitNode",
          "struct": "/Script/ControlRig.RigUnit_BeginExecution",
          "event": "Forwards Solve",
          "position": [
            0,
            0
          ]
        },
        {
          "node": "SetPelvis",
          "title": "Set Transform",
          "class": "RigVMUnitNode",
          "struct": "/Script/ControlRig.RigUnit_SetTransform",
          "position": [
            400,
            0
          ]
        },
        {
          "node": "AddLift",
          "title": "Add",
          "class": "RigVMUnitNode",
          "struct": "",
          "position": [
            200,
            300
          ]
        }
      ],
      "links": [
        {
          "from": "RigUnit_BeginExecution.ExecutePin",
          "to": "SetPelvis.ExecutePin"
        }
      ]
    }
  }
}
