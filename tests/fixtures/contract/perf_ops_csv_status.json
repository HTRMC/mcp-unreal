{
  "name": "perf_ops_csv_status",
  "description": "perf_ops csv_status: whether the CSV profiler is available and capturing",
  "route": "/api/editor/perf",
  "tool": "perf_ops",
  "request": {
    "operation": "csv_status"
  },
  "status": 200,
  "response": {
    "ok": true,
    "data": {
      "available": true,
      "capturing": false,
      "output_filename": ""
    }
  }
}
